MONGO_URI=mongodb://127.0.0.1:27017/techneeds?replicaSet=techneedsLocal
PORT=8000
HOST=127.0.0.1
FRONTEND_ORIGIN=http://localhost:3000
JWT_SECRET=
ADMIN_KEY=

# Optional: path to a Python environment with solver/requirements.txt installed.
# SOLVER_PYTHON=/absolute/path/to/python

# Local video walkthrough only; production always disables demo access.
DEMO_MODE=false
# Demo mode uses an isolated techneeds_demo database.

# Optional live TechGuide AI providers (server-only; Gemini takes priority).
GEMINI_API_KEY=
GEMINI_GUIDE_MODEL=gemini-3.5-flash
OPENAI_API_KEY=
OPENAI_GUIDE_MODEL=gpt-4.1-mini
